# TKAWEN Studio · Environment configuration
# Copy to .env and fill values. Never commit .env.

# TTS API endpoint (default: production tts.tkawen.com)
TKAWEN_TTS_URL=https://tts.tkawen.com

# Studio API key (request from admin@tkawen.com)
TKAWEN_API_KEY=tkw_studio_REPLACE_ME

# Override TTS mode globally (overrides template yaml)
# api | sovereign | cloud | hybrid | clone
# TKAWEN_TTS_MODE=api
